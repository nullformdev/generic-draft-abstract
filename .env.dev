# Local development defaults.
PORT=3000
HOST=127.0.0.1
DOMAIN=localhost

# Database
DB_PATH=./data/dev.db

# Auth
INVITE_CODE=dev
SESSION_MAX_AGE=604800000

# i18n
DEFAULT_LANG=ru

# Logging
LOG_SOCKET_PATH=./data/log.sock
LOG_DB_PATH=./data/logs.dev.db
LOG_RETENTION_DAYS=7
LOG_QUEUE_LIMIT=500
LOG_SLOW_DB_MS=50
